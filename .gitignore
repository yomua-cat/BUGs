# 资源缓存（超大，每次合并卡死的元凶）
/[Ll]ibrary/
src/[Ll]ibrary/

# 临时文件
/[Tt]emp/
src/[Tt]emp/

# 编译中间产物
/[Oo]bj/
src/[Oo]bj/

# 构建输出
/[Bb]uild/
/[Bb]uilds/
src/[Bb]uild/
src/[Bb]uilds/

# 日志
/[Ll]ogs/
src/[Ll]ogs/

# 用户本地设置
/[Uu]ser[Ss]ettings/
src/[Uu]ser[Ss]ettings/

# Visual Studio
/.vs/
/*.csproj
/*.sln
/*.unityproj
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.mdb
/*.opendb
/*.VC.db
/*.userprefs

# Asset meta files（Unity 自动生成，保留）
# !*.meta

